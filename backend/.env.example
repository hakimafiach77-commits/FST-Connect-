# ==============================================================================
# FST-Connect - Backend Configuration d'environnement (.env.example)
# ==============================================================================
# Copiez ce fichier vers .env dans backend/ pour exécuter le backend hors Docker.

POSTGRES_USER=user
POSTGRES_PASSWORD=changer_ce_mot_de_passe_en_production
POSTGRES_DB=fst_db
PORT=5000

JWT_SECRET=changer_cette_cle_secrete_par_une_chaine_aleatoire_robuste
JWT_EXPIRES_IN=30d

# Connexion depuis Windows vers le conteneur Docker ou PostgreSQL local (port hôte 5433) :
DATABASE_URL="postgresql://user:changer_ce_mot_de_passe_en_production@localhost:5433/fst_db?schema=public"

# Connexion depuis le conteneur backend Docker (port interne db 5432) :
# DATABASE_URL="postgresql://user:changer_ce_mot_de_passe_en_production@db:5432/fst_db"

