# ==============================================================================
# FST-Connect - Configuration d'environnement (.env.example)
# ==============================================================================
# Copiez ce fichier vers .env à la racine et vers backend/.env selon votre besoin.
# Ne commitez JAMAIS de fichiers .env contenant de vrais secrets.

# --- PostgreSQL Database ---
POSTGRES_USER=user
POSTGRES_PASSWORD=changer_ce_mot_de_passe_en_production
POSTGRES_DB=fst_db

# --- Port Serveur Express ---
PORT=5000

# --- JSON Web Token (JWT) ---
# Clé secrète robuste obligatoire (min 32 caractères recommandés)
JWT_SECRET=changer_cette_cle_secrete_par_une_chaine_aleatoire_robuste
# Format accepté par jsonwebtoken avec unité explicite (ms, s, m, h, d, w, y)
JWT_EXPIRES_IN=30d

# --- URLs de connexion Prisma / PostgreSQL ---
# NOTE IMPORTANTE SUR LES PORTS ET HÔTES :
# 1. Connexion depuis l'hôte Windows (scripts locaux, tests locaux, Prisma CLI sur l'hôte) :
#    Le port 5432 étant occupé par d'autres services sur l'hôte, le port exposé est 5433.
DATABASE_URL="postgresql://user:changer_ce_mot_de_passe_en_production@localhost:5433/fst_db?schema=public"

# 2. Connexion depuis l'intérieur du réseau Docker (conteneur backend vers conteneur db) :
#    Le service PostgreSQL s'appelle 'db' et écoute sur son port interne standard 5432.
# DATABASE_URL="postgresql://user:changer_ce_mot_de_passe_en_production@db:5432/fst_db"

